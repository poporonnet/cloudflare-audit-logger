{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-audit-logger",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-21",
  "keep_vars": true,
  "minify": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "CLOUDFLARE_AUDIT_LOGGER",
      "id": "dfee274f305c4c85bc9de94413fa358e"
    }
  ]
}