{
  "name": "cloudflare-audit-logger",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "CLOUDFLARE_AUDIT_LOGGER",
      "id": "cloudflare-audit-logger"
    }
  ]
}